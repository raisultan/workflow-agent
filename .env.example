# Workflow Agent: the environment for `docker compose --profile full up -d`.
# Copy this file to .env and fill it in; Compose reads .env from this folder. The demo (`docker compose up -d`) needs none of it.
# docs/getting-started.md walks through every value; docs/DEPLOYMENT.md §4 has the full list.

# --- The model, through LiteLLM or any OpenAI-compatible endpoint (D1, PRD decision 3) ---
LITELLM_BASE_URL=http://host.docker.internal:4000/v1
LITELLM_API_KEY=
# The model alias the stages and the reply verdict use (provider/model is added by the profile).
LITELLM_MODEL=deepseek-v4-pro

# --- Who may start jobs: comma-separated usernames, added to every source (Mattermost usernames are looked up). Empty: nobody. ---
WORKBENCH_ALLOWED_SENDERS=dev-ivan,lead-1

# --- Jira (Server or Data Center REST v2): a personal access token, or a username and password ---
JIRA_BASE_URL=https://jira.example.com
JIRA_TOKEN=
JIRA_USERNAME=
JIRA_PASSWORD=
# The account the workbench comments as; a mention of it in a ticket starts a job.
JIRA_BOT_USERNAME=workflow-agent
JIRA_BOT_ACCOUNT_ID=

# --- Mattermost: a bot account's token, and the team it works in ---
MATTERMOST_BASE_URL=https://mattermost.example.com
MATTERMOST_TOKEN=
MATTERMOST_BOT_USER_ID=
MATTERMOST_TEAM_ID=

# --- GitLab: a token with api scope on the repository's project ---
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT=acme/app

# --- The repository the example profile serves (examples/profile.cordis.patch.yml); edit the profile for more than one ---
# repo:<name> in a message picks it; the Jira project and the Mattermost channel (its id) map threads to it.
REPOSITORY_NAME=app
REPOSITORY_TARGET_BRANCH=main
REPOSITORY_TEST_COMMAND=npm test
# npm, pypi or go, comma-separated.
REPOSITORY_REGISTRIES=npm
JIRA_PROJECT=APP
MATTERMOST_CHANNEL_ID=
# The only people who approve this repository's plans, by email, comma-separated; empty: the profile's policy decides.
APPROVER_EMAILS=

# --- The dashboard: names besides loopback it may be reached by (an authenticating proxy's), comma-separated ---
WORKBENCH_DASHBOARD_HOSTS=
